a,b,c = map(int, input("Введите (через пробел) длины трёх сторон треугольника: ").split())

if (a > b+c) and (b > a+c) and (c > a+b): #правило треугольника, по которому он может существовать
    if a == b == c:
        print("Треугольник равносторонний")

    elif a == b or b == c or a == c:
        print("Треугольника равнобедренный")

    else:
        print("Треугольник разносторонний")
else:
    print("Такого треугольника не существует")

