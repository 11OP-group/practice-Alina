row1, column1 = map(int,input("Введите координату первой шахмотной клетки (строку и столбец) (через запятую): ").split(","))
row2, column2 = map(int,input("Введите координату второй шахмотной клетки (строку и столбец) (через запятую): ").split(","))
if (0 < row1 < 9 or 0 < column1 < 9) or (0 < row2 < 9 or 0 < column2 < 9):
    def colour(a,b):
        """
        Находит цвет клетки по координатам шахматной клетки
        :param a: строка шахматной доски
        :param b: столбец шахматной доски
        :return: цвет шахматной клетки
        """
        if (a%2 == 0 and b%2 != 0) or (a%2 != 0 and b%2 == 0):
            return "Чёрный цвет"

        if (a%2 == 0 and b%2 == 0) or (a%2 != 0 and b%2 != 0):
            return "Белый цвет"

    one = colour(row1,column1)
    two = colour(row2,column2)

    if one == two:
        print(f"Клетки покрашены в один цвет: {one}")
    else:
        print(f"Клетки покрашены в разные цвета: {one} и {two}")
else:
    print("Введите числа от 1 до 8!")

