x1,y1 = map(int,input("Введите координаты первой клетки (через запятую): ").split(","))
x2,y2 = map(int,input("Введите координаты второй клетки (через запятую): ").split(","))
if (0 < x1 < 9 and 0 < y1 < 9) and (0 < x2 < 9 and 0 < y2 < 9):
    if abs(x1 - x2) == abs(y1 - y2):
        print("Из первой клетки ходом слона можно попасть во вторую")
    else:
        print("Нельзя попасть во вторую клетку")

else:
    print("Ошибка! Введите числа от 1 до 8.")
