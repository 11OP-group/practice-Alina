temp = float(input("Введите вашу температуру (в цельсиях): "))
press_up = float(input("Введите ваше верхнее давление: "))
pulse = float(input("Введите ваш пульс (уд/мин): "))

if (36 <= temp <= 37) and (110 <= press_up <= 130) and (60 <= pulse <= 100):
    print(f"У вас нормальное состояние")

if ((35 < temp < 36) or (37 < temp < 38)) and ((105 < press_up < 110) or (130 < press_up < 140)) and ((55 < pulse < 60) or (100 < pulse < 110)):
    print(f"У вас лёгкое недомогание")

if (temp <= 35 or temp >= 38) or (press_up <= 105 or press_up >= 140) or (pulse <= 55 or pulse >= 110):
    print(f"Вам требуется врач")
