for a in range(1,150):
    for b in range(a,150):
        for c in range(b,150):
            for d in range(c,150):
                sum = a**5 + b**5 + c**5 + d**5 #сумма всех четырёх чисел в пятой степени присваиваем пременной sum

                e = round(sum**0.2)

                if e**5 == sum and e <= 150:
                    print(f"Числа: {a}, {b}, {c}, {d}")
                    print(f"Их сумма: {a+b+c+d+e}")
                    exit()
