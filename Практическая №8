#Задание 6
from random import randint
num = randint(1,10)

print("==========================")
print("Машина загадала число от 1 до 10. Ваша задача угадать это число. У вас 3 попытки.")

for i in range(3,0,-1):
    print("==========================")
    print(f"Осталось попыток {i}:")
    n = int(input("Введите число: ")) #Число вводит пользователь
    if n > num: print("Меньше")
    elif n < num: print("Больше")
    else:
        print("Вы угадали число!!!")
        exit()

print("==========================")
print("Вы не угадали число :(")
print(f"Загаданное число: {num}")
