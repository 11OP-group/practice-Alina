from math import *

width = float(input("Введите ширину прямоугольника: "))
height = float(input("Введите длину прямоугольника: "))

def calculate_rectangle_area(width, height):
    """
    Вычисляет площадь прямоугольника по
    заданным параметрам (по ширине и длине).
    :param width: (float): Высота прямоугольника
    :param height: (float): Ширина прямоугольника
    :return: (float): Площадь прямоугольника
    """
    rectangle_area = width * height
    return(rectangle_area)
print(f"Площадь прямоугольника: {calculate_rectangle_area(width, height)}")


print(f"==============================")


radius = float(input("Введите радиус круга: "))

def calculate_circle_area(radius):
    """
    Вычисляет площадь круга по заданному
    параметру (по радиусу круга).
    :param radius: (float):  Радиус круга
    :return: (float): Площадь круга
    """
    circle_area = pi * radius**2
    return(circle_area)
print(f"Площадь круга: {calculate_circle_area(radius):.2f}")

