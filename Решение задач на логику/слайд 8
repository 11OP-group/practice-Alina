n = int(input("1: "))
c = 0 #счётчик чисел, которые не дел
k = 1 #начинаем проверять с 1
a = [] #какие именно числа не делятся на 2,3,5
if n>0:
    while k<=n:
        if k%2==0 or k%3==0 or k%5==0:
            k+=1 #переходим к следующему числу
        else:
            c+=1 #добавляем число в счётчик
            a.append(k) #добавляем число в массив а
            k+=1 #переходим к следующему числу

print(a,c)
