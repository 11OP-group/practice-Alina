one = int(input("Введите первое число: "))
two = int(input("Введите второе число: "))

def knv(a,b):
    s = 0  # сумма чётных чисел
    k = 0  # сумма нечётных чисел
    while a<=b:
        if a%2==0: #если а - чётное
            s+=a
            a+=1
        else: #если а - нечётное
            k+=a
            a+=1
    return(s,k,s-k)

print(knv(one,two))
