n = int(input("Введите натуральное число: "))

def summa_digits(x):
    sum = 0 #сумма цифр числа
    while x>0:
        sum+=x%10
        x//=10 #забираем конечный разряд у числа, например: 987 -> 98
    return(sum)

k = n #даём значение n новой переменной k (чтобы n не изменялась)
while k>9:
    k = summa_digits(k)
print(k)
