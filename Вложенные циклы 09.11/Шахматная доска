white = "W"
black = "B"
size = 8
for i in range(1,size+1):
    if i%2!=0:
        for j in range(1,size-3):
            print(white, end=' ')
            print(black, end=' ')
    else:
        for j in range(1, size - 3):
            print(black, end=' ')
            print(white, end=' ')
    print(end='\n')
