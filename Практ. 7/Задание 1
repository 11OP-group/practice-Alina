rating = int(input("Введите числовой рейтинг продукта: "))

match rating:
    case 10 | 9 | 8:
        print(f"Рейтинг {rating} -> Отличный продукт! 🔥 Настоятельно рекомендую!")

    case 7 | 6 | 5:
        print(f"Рейтинг {rating} -> Средний продукт. 👍 Можно попробовать!")

    case 4 | 3 | 2 | 1:
        print(f"Рейтинг {rating} -> Плохой продукт. 😡 Не рекомендую")
    case _:
        print(f"{rating} - неверно введён числовой рейтинг ❌")
        print(f"Числовой рейтинг должен быть от 1 до 10.")
