status = str(input("Введите ваш статус заказа: "))

print("======================================")
print("     📦 СТАТУС ВАШЕГО ЗАКАЗА 📦       ")
print("======================================")

match status:
    case "pending":
        print("Статус: В ожидании ⏰")
        print("Описание: Заказ оформлен, но ещё не передан обработку.")
        print("Примерное время: 1-2 дня")
        print("Рекомендация: Ожидайте подтверждения заказа")

    case "processing":
        print("Статус: В обработке ⚙️")
        print("Описание: Ваш заказ собирается и упаковывается на складе.")
        print("Примерное время: 2-3 дня")
        print("Рекомендация: Пожалуйста, ожидайте передачи заказа в службу доставки.")

    case "shipped":
        print("Статус: Отправлено ✈️")
        print("Описание: Ваш заказ находится в пути к вам.")
        print("Примерное время: 2-5 дней")
        print("Рекомендация: Пожалуйста, ожидайте передачи заказа в службу доставки.")

    case "delivered":
        print("Статус: Доставлено 🎉")
        print("Описание: Заказ успешно доставлен по указанному адресу.")
        print("Примерное время: Заказ уже у вас")
        print("Рекомендация: Приятного использования!")

    case "cancelled":
        print("Статус: Отменено ❌")
        print("Описание: Ваш заказ был отменён.")
        print("Примерное время: -")
        print("Рекомендация: Если это произошло по ошибке, свяжитесь с поддержкой.")

    case _:
        print(f"❌ Ошибка: Неизвестный статус '{status}' ")
        print("Доступные статусы: pending, processing, shipped, delivered, cancelled")

